{
  "manifest_version": 3,
  "name": "SwiftMiner Query Hash Discovery",
  "version": "1.41.1",
  "description": "Updates SwiftMiner's Twitch query hashes on request. Idle otherwise.",
  "action": {
    "default_title": "SwiftMiner",
    "default_popup": "popup.html",
    "default_icon": "swiftminer-icon.png"
  },
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "swiftminer-icon.png"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    }
  ],
  "icons": {
    "96": "swiftminer-icon.png"
  }
}
