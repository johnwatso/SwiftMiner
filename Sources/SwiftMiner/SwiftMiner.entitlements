<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets "Email Invitation…" ask Mail to open a pre-written invitation
	     draft. macOS still asks the user for permission the first time, and
	     SwiftMiner never sends the message itself. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
